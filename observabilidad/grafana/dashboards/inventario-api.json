      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_response_status_code) (http_server_request_duration_seconds_count{job=\"inventario-api\",http_route=\"/api/productos\",http_request_method=\"POST\"})",
