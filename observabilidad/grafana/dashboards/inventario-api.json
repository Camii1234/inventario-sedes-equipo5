          },
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"inventario-api\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "editorMode": "code"
