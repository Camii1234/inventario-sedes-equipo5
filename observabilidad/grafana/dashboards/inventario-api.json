        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"inventario-api\",http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"inventario-api\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "editorMode": "code"
