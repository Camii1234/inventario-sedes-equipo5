# Copie este archivo como .env para cambiar credenciales o puertos (opcional).
# Sin .env, compose.yaml usa estos mismos valores por defecto, pensados solo para desarrollo local.
MYSQL_DATABASE=inventario
MYSQL_USER=inventario
MYSQL_PASSWORD=inventario_dev
MYSQL_ROOT_PASSWORD=root_dev

# Puertos publicados en el host
WEB_PORT=3000
API_PORT=8080
MYSQL_PORT=3308
